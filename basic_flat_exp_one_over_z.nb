  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<basic_flat_exp_one_over_z.png\>\"", ",", 
    RowBox[{"DensityPlot", "[", 
     RowBox[{
      RowBox[{"Arg", "[", 
       RowBox[{"f", "[", 
        RowBox[{"x", "+", 
         RowBox[{"I", " ", "y"}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{
         RowBox[{"-", "9"}], "/", "16"}], ",", 
        RowBox[{"9", "/", "16"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{
         RowBox[{"-", "9"}], "/", "16"}], ",", 
        RowBox[{"9", "/", "16"}]}], "}"}], ",", 
      RowBox[{"ColorFunction", "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Hue", "[", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "#"}], "/", 
             RowBox[{"(", 
              RowBox[{"2", " ", "Pi"}], ")"}]}], ",", "1"}], "]"}], "]"}], 
         "&"}], ")"}]}], ",", 
      RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
      RowBox[{"MaxRecursion", "->", "2"}], ",", 
      RowBox[{"Exclusions", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "==", "0"}], "&&", 
         RowBox[{"y", "==", "0"}]}], "}"}]}], ",", 
      RowBox[{"PlotPoints", "->", "1152"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Re(z)\>\"", ",", "\"\<Im(z)\>\""}], "}"}]}]}], "]"}], 
